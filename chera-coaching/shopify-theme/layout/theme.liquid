<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{{ page_title }}{% if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif %}{% if current_page != 1 %} &ndash; {{ 'general.pagination.page' | t: page: current_page }}{% endif %}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}</title>
  {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
  <link rel="canonical" href="{{ canonical_url }}">
  {% if settings.favicon != blank %}<link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64 }}">{% else %}<link rel="icon" type="image/png" href="{{ 'chera-favicon-64.png' | file_url }}"><link rel="apple-touch-icon" href="{{ 'chera-favicon-180.png' | file_url }}">{% endif %}
  {%- assign chat_url = settings.chat_url | default: '/apps/chat' -%}{% if request.path contains chat_url %}<link rel="manifest" href="{{ chat_url }}/manifest.webmanifest"><meta name="apple-mobile-web-app-capable" content="yes"><meta name="apple-mobile-web-app-title" content="Chera Chat"><meta name="theme-color" content="#0e0d0d">{% endif %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Barlow:wght@400;500;600&display=swap">
  {{ content_for_header }}
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  <style>:root{--red:{{ settings.color_accent }};--bg:{{ settings.color_bg }};--fg:{{ settings.color_fg }}}</style>
  <script>window.CHERA = { endpoint: {{ settings.eval_endpoint | json }}, customer: {% if customer %}{ id: {{ customer.id }}, name: {{ customer.first_name | json }}, email: {{ customer.email | json }}, phone: {{ customer.phone | json }} }{% else %}null{% endif %} };</script>
</head>
<body class="template-{{ template.name }}{% if template.suffix %} template-{{ template.name }}-{{ template.suffix }}{% endif %}">
  <a class="skip" href="#MainContent">{{ 'general.accessibility.skip' | t }}</a>
  {% sections 'header-group' %}
  <main id="MainContent" role="main">
    {{ content_for_layout }}
  </main>
  {% sections 'footer-group' %}
  {{ 'theme.js' | asset_url | script_tag }}
</body>
</html>
