<section class="band paper" id="evaluare">
  <div class="in stack center" style="gap:20px">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h2>{{ section.settings.title }}</h2>
    <p class="lead muted" style="max-width:56ch">{{ section.settings.text }}</p>
    <a class="btn" href="{{ section.settings.cta_url }}">{{ section.settings.cta_label }}</a>
  </div>
</section>

{% schema %}
{
  "name": "Îndemn evaluare",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Supratitlu", "default": "Pasul 1, gratuit" },
    { "type": "text", "id": "title", "label": "Titlu", "default": "Află profilul tău neuro și ușa potrivită" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "4 minute, 72 de afirmații, rezultatul pe loc. Apoi îți scriu eu pe WhatsApp cu planul de pornire." },
    { "type": "text", "id": "cta_label", "label": "Buton", "default": "Începe evaluarea" },
    { "type": "url", "id": "cta_url", "label": "Link", "default": "/pages/evaluare" }
  ],
  "presets": [{ "name": "Îndemn evaluare" }]
}
{% endschema %}
