{%- comment -%} datele firmei: setarea temei, sau cele din subsol cât timp setarea are încă liniuțe {%- endcomment -%}
{%- assign legal = settings.company_details -%}{%- if legal == blank or legal contains '__' -%}{%- assign legal = section.settings.company_line -%}{%- endif -%}
<footer class="site-footer">
  {%- if section.settings.cta_title != blank -%}
  <div class="ft-cta">
    <div class="in">
      <div>
        <p class="eyebrow">{{ section.settings.cta_eyebrow }}</p>
        <h2>{{ section.settings.cta_title }}</h2>
      </div>
      <a class="btn" href="{{ section.settings.cta_url }}">{{ section.settings.cta_label }} <span aria-hidden="true">→</span></a>
    </div>
  </div>
  {%- endif -%}

  <div class="in ft-main">
    <div class="ft-brand">
      <a class="brand" href="{{ routes.root_url }}" aria-label="Chera Protocol, prima pagină">{% render 'logo-stamp' %}</a>
      <p>{{ section.settings.tagline }}</p>
      <div class="ft-social">
        {%- if settings.instagram != blank -%}
        <a href="https://www.instagram.com/{{ settings.instagram }}/" target="_blank" rel="noopener" aria-label="Instagram">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.3" cy="6.7" r="1.1" class="dot"/></svg>
        </a>
        {%- endif -%}
      </div>
    </div>

    <nav class="ft-col" aria-label="Site">
      <h3>Site</h3>
      <a href="/#problema">Problema</a>
      <a href="/#metoda">Metoda</a>
      <a href="/#rezultate">Rezultate</a>
      <a href="/blogs/articole">Articole</a>
      <a href="/#intrebari">Întrebări</a>
    </nav>

    <nav class="ft-col" aria-label="Coaching">
      <h3>Coaching</h3>
      <a href="/pages/evaluare">Evaluare gratuită</a>
      <a href="/products/chera-protocol-coaching-1-luna">Coaching online</a>
      <a href="/products/pregatire-de-concurs-prima-luna">Pregătire de concurs</a>
      <a href="/collections/programe">Programe · 200 lei</a>
      <a href="{{ routes.account_url }}">Contul meu</a>
      {% if customer %}<a href="{{ routes.account_logout_url }}">Ieșire din cont</a>{% endif %}
    </nav>

    <nav class="ft-col" aria-label="Legal">
      <h3>Legal</h3>
      {%- for link in section.settings.menu.links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
      <a href="https://anpc.ro/" target="_blank" rel="noopener">ANPC</a>
    </nav>

    <div class="ft-col">
      <h3>Contact</h3>
      <a href="/apps/chat">Chatul meu (pentru clienți, din cont)</a>
      {%- if settings.instagram != blank -%}<a href="https://www.instagram.com/{{ settings.instagram }}/" target="_blank" rel="noopener">@{{ settings.instagram }}</a>{%- endif -%}
      {%- if section.settings.email != blank -%}<a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>{%- endif -%}
      <span>{{ section.settings.city }}</span>
    </div>
  </div>

  <div class="in ft-badges">
    <a class="ft-badge" href="https://anpc.ro/ce-este-sal/" target="_blank" rel="noopener"><small>Soluționarea alternativă</small>a litigiilor · ANPC SAL</a>
    <a class="ft-badge" href="https://ec.europa.eu/consumers/odr" target="_blank" rel="noopener"><small>Soluționarea online</small>a litigiilor · SOL</a>
    <p class="ft-note">{{ section.settings.legal_note }}</p>
  </div>

  <div class="ft-word" aria-hidden="true">CHERA PROTOCOL</div>

  <div class="ft-bottom">
    <div class="in">
      <p>© {{ 'now' | date: '%Y' }} {{ settings.company }} · {{ legal }}</p>
      <p>Online coaching · Marius Chera</p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Subsol",
  "settings": [
    { "type": "text", "id": "cta_eyebrow", "label": "Îndemn – titlu mic", "default": "Primul pas e gratuit" },
    { "type": "text", "id": "cta_title", "label": "Îndemn – titlu", "default": "Află în 4 minute ce ți se potrivește" },
    { "type": "text", "id": "cta_label", "label": "Îndemn – buton", "default": "Fă evaluarea" },
    { "type": "text", "id": "cta_url", "label": "Îndemn – link", "default": "/pages/evaluare" },
    { "type": "textarea", "id": "tagline", "label": "Text sub logo", "default": "Antrenament, nutriție și suplimente scrise de mine pe datele tale. Pentru cei care vor scenă sau doar un fizic de sportiv." },
    { "type": "text", "id": "email", "label": "E-mail de contact" },
    { "type": "text", "id": "city", "label": "Oraș", "default": "Sibiu · online în toată țara" },
    { "type": "link_list", "id": "menu", "label": "Meniu legal", "default": "footer" },
    { "type": "text", "id": "company_line", "label": "Date firmă (dacă nu sunt în setările temei)", "default": "CUI 49666258 · J32/416/2024 · sediul: Calea Dumbrăvii 137A, Sc. A, Et. 1, Ap. 2, 550399 Sibiu" },
    { "type": "text", "id": "legal_note", "label": "Notă", "default": "Chera Protocol este un program de antrenament și nutriție; nu înlocuiește consultul medical." }
  ]
}
{% endschema %}
