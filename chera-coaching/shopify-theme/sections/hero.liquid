<header class="hero" id="top">
  <div class="in">
    <div class="stack">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- assign t = section.settings.title | strip -%}{%- assign parts = t | split: '. ' -%}
      {%- if parts.size > 1 -%}{%- assign last = parts | last -%}{%- assign n = parts.size | minus: 1 -%}{%- assign first = parts | slice: 0, n | join: '. ' -%}<h1>{{ first }}. <span class="accent">{{ last }}</span></h1>{%- else -%}<h1>{{ t }}</h1>{%- endif -%}
      <p class="lead muted">{{ section.settings.text }}</p>
      <div class="cta-row"><a class="btn" href="{{ section.settings.cta_url }}">{{ section.settings.cta_label }}</a>{% if section.settings.cta3_label != blank %}<a class="btn" href="{{ section.settings.cta3_url }}">{{ section.settings.cta3_label }}</a>{% endif %}<a class="link-arrow" href="{{ section.settings.cta2_url }}">{{ section.settings.cta2_label }} →</a></div>
      <div class="proof-mini"><span><b>{{ section.settings.mini_1_v }}</b>{{ section.settings.mini_1 }}</span><span><b>{{ section.settings.mini_2_v }}</b>{{ section.settings.mini_2 }}</span><span><b>{{ section.settings.mini_3_v }}</b>{{ section.settings.mini_3 }}</span></div>
    </div>
    {% if section.settings.image != blank %}
      <figure class="fig">{{ section.settings.image | image_url: width: 1000 | image_tag: loading: 'eager', alt: section.settings.caption }}<figcaption>{{ section.settings.caption }}</figcaption></figure>
    {% elsif section.settings.image_file != blank %}
      <figure class="fig"><img src="{{ section.settings.image_file | file_url }}" alt="{{ section.settings.caption | escape }}" width="640" height="800"><figcaption>{{ section.settings.caption }}</figcaption></figure>
    {% else %}
      <div class="placeholder">Poză: Marius cu un sportiv la cardul IFBB Pro</div>
    {% endif %}
  </div>
  <div class="stripe"></div>
</header>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Supratitlu", "default": "Online coaching · Marius Chera" },
    { "type": "textarea", "id": "title", "label": "Titlu", "default": "România are mai multe săli ca niciodată. Majoritatea oamenilor din ele arată la fel ca acum doi ani." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Chera Protocol este metoda cu care am făcut 10 IFBB Pro, aplicată la tine. Eu îți fac planul, eu îl ajustez, eu îți răspund. Fie că vrei să urci pe scenă, fie doar să arăți ca unul care ar putea." },
    { "type": "text", "id": "cta_label", "label": "Buton 1", "default": "Fă evaluarea gratuită" },
    { "type": "text", "id": "cta_url", "label": "Link 1", "default": "/pages/evaluare" },
    { "type": "text", "id": "cta3_label", "label": "Buton roșu 2 (gol = ascuns)", "default": "Analiza de concurs gratuită" },
    { "type": "text", "id": "cta3_url", "label": "Link buton roșu 2", "default": "/pages/analiza-concurs" },
    { "type": "text", "id": "cta2_label", "label": "Buton 2", "default": "Vezi rezultatele" },
    { "type": "text", "id": "cta2_url", "label": "Link 2", "default": "/#rezultate" },
    { "type": "text", "id": "mini_1_v", "label": "Dovadă 1 – cifră", "default": "10" },
    { "type": "text", "id": "mini_1", "label": "Dovadă 1 – text", "default": "carduri IFBB Pro" },
    { "type": "text", "id": "mini_2_v", "label": "Dovadă 2 – cifră", "default": "223" },
    { "type": "text", "id": "mini_2", "label": "Dovadă 2 – text", "default": "locuri 1" },
    { "type": "text", "id": "mini_3_v", "label": "Dovadă 3 – cifră", "default": "100+" },
    { "type": "text", "id": "mini_3", "label": "Dovadă 3 – text", "default": "clienți online" },
    { "type": "image_picker", "id": "image", "label": "Poză" },
    { "type": "text", "id": "image_file", "label": "Sau numele pozei din Content → Files", "default": "chera-galerie-61.jpg" },
    { "type": "text", "id": "caption", "label": "Legendă", "default": "Încă un card IFBB Pro pentru un sportiv pregătit de mine" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
