<section class="band" id="intrebari" style="padding-top:0">
  <div class="in stack" style="gap:28px">
    <div class="stack"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.title }}</h2></div>
    <div>
      {% for block in section.blocks %}<details {{ block.shopify_attributes }}><summary>{{ block.settings.q }}</summary><p>{{ block.settings.a }}</p></details>{% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Întrebări frecvente",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Supratitlu", "default": "Întrebări frecvente" },
    { "type": "text", "id": "title", "label": "Titlu", "default": "Înainte să începi" }
  ],
  "blocks": [{ "type": "qa", "name": "Întrebare", "settings": [
    { "type": "text", "id": "q", "label": "Întrebare" },
    { "type": "textarea", "id": "a", "label": "Răspuns" }
  ]}],
  "presets": [{ "name": "Întrebări frecvente", "blocks": [
    { "type": "qa", "settings": { "q": "Trebuie să concurez ca să lucrez cu tine?", "a": "Nu. Ușa B, Chera Protocol Coaching, e pentru oameni care nu concurează și nici nu vor. Aceeași metodă, aplicată la obiectivul tău." } },
    { "type": "qa", "settings": { "q": "Cine îmi face planul și cine îmi răspunde?", "a": "Eu, Marius. Nu am alți antrenori și nu am asistenți care să răspundă în locul meu. Fiecare plan, fiecare check-in și fiecare mesaj sunt ale mele. De aceea locurile sunt limitate." } },
    { "type": "qa", "settings": { "q": "Ce e profilul neuro și de ce contează?", "a": "Un chestionar de 4 minute, construit de mine din ce am văzut la sportivii mei, pornind orientativ de la modelul Braverman al celor patru neurotransmițători, care arată cum ești făcut: cât de mult ai nevoie de intensitate, varietate, rutină sau calm. Pe baza lui aleg stilul de antrenament, distribuția carbohidraților și suplimentele. Nu e un test medical." } },
    { "type": "qa", "settings": { "q": "Cum comunicăm?", "a": "Pe WhatsApp, direct cu mine, din contul tău de pe site. Răspund în cel mult 24 de ore în zilele lucrătoare. Check-in-ul săptămânal se face printr-un formular scurt plus poze și cântar." } },
    { "type": "qa", "settings": { "q": "Ce se întâmplă când expiră abonamentul?", "a": "Primești de la mine mesaj cu 7, 3 și o zi înainte. Dacă nu reînnoiești, accesul la planul tău și la WhatsApp se închide automat după 3 zile de grație. Când reînnoiești, continuăm exact de unde am rămas." } },
    { "type": "qa", "settings": { "q": "Cât durează până se vede?", "a": "Prima schimbare vizibilă în poze apare de obicei în 4–6 săptămâni. Garanția e la 12." } },
    { "type": "qa", "settings": { "q": "Ce se întâmplă cu datele mele?", "a": "Răspunsurile la evaluare și pozele de check-in le folosesc doar pentru planul tău și le păstrez cât ești client, plus 12 luni. Nu public nimic fără acordul tău scris." } }
  ]}]
}
{% endschema %}
