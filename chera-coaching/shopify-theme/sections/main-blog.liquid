<section class="band">
  <div class="in stack" style="gap:28px">
    <div class="stack"><p class="eyebrow">Articole</p><h1 style="font-size:clamp(36px,6vw,64px)">{{ blog.title }}</h1><p class="lead muted">{{ section.settings.text }}</p></div>
    {% paginate blog.articles by 12 %}
    <div class="articles">
      {% for article in blog.articles %}
        <article class="art">
          {% if article.image != blank %}<a href="{{ article.url }}">{{ article.image | image_url: width: 700 | image_tag: loading: 'lazy', alt: article.title }}</a>{% endif %}
          <span class="meta">{{ article.published_at | date: "%d.%m.%Y" }}{% if article.tags.size > 0 %} · {{ article.tags | first }}{% endif %}</span>
          <h3><a href="{{ article.url }}">{{ article.title }}</a></h3>
          <p>{{ article.excerpt_or_content | strip_html | truncatewords: 28 }}</p>
        </article>
      {% endfor %}
    </div>
    {% if paginate.pages > 1 %}<div class="row">{% if paginate.previous %}<a class="btn ghost btn-sm" href="{{ paginate.previous.url }}">{{ 'general.pagination.previous' | t }}</a>{% endif %}{% if paginate.next %}<a class="btn ghost btn-sm" href="{{ paginate.next.url }}">{{ 'general.pagination.next' | t }}</a>{% endif %}</div>{% endif %}
    {% endpaginate %}
  </div>
</section>
{% schema %}{ "name": "Blog", "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "Scrise de mine, din ce văd la sportivii pe care îi antrenez." } ] }{% endschema %}
