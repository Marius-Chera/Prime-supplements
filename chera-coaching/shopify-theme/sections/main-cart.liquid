<section class="band"><div class="in narrow stack" style="gap:24px">
  <h1 style="font-size:clamp(36px,6vw,64px)">{{ 'general.cart.title' | t }}</h1>
  {% if cart.item_count == 0 %}
    <p class="muted">{{ 'general.cart.empty' | t }}</p><a class="btn ghost" href="{{ routes.root_url }}" style="justify-self:start">{{ 'general.cart.continue' | t }}</a>
  {% else %}
  <form action="{{ routes.cart_url }}" method="post" class="stack">
    {% for item in cart.items %}
      <div class="cart-line">
        {% if item.image != blank %}{{ item.image | image_url: width: 160 | image_tag: alt: item.title }}{% else %}<div></div>{% endif %}
        <div><b style="font-family:var(--display);font-size:20px;text-transform:uppercase">{{ item.product.title }}</b>{% if item.variant.title != 'Default Title' %}<div class="muted">{{ item.variant.title }}</div>{% endif %}<div class="muted">{{ item.final_price | money }} × <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" style="width:60px;padding:6px;background:var(--bg-2);color:var(--fg);border:1px solid var(--line);border-radius:4px"> · <a href="{{ item.url_to_remove }}">{{ 'general.cart.remove' | t }}</a></div></div>
        <strong>{{ item.final_line_price | money }}</strong>
      </div>
    {% endfor %}
    <div class="row between"><button class="btn ghost btn-sm" type="submit" name="update">{{ 'general.cart.update' | t }}</button><div><span class="muted">{{ 'general.cart.subtotal' | t }}</span> <strong class="price-big" style="font-size:28px">{{ cart.total_price | money }}</strong></div></div>
    {% unless customer %}<p class="note">La checkout îți faci contul în 30 de secunde: acolo primești planul, check-in-ul și WhatsApp-ul meu.</p>{% endunless %}
    <button class="btn" type="submit" name="checkout" style="justify-self:end">{{ 'general.cart.checkout' | t }}</button>
  </form>
  {% endif %}
</div></section>
{% schema %}{ "name": "Coș", "settings": [] }{% endschema %}
