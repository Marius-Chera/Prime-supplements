<section class="band">
  <div class="in stack" style="gap:28px">
    <div class="stack"><p class="eyebrow">Pachete și programe</p><h1 style="font-size:clamp(36px,6vw,64px)">{{ collection.title }}</h1>{% if collection.description != blank %}<div class="lead muted">{{ collection.description }}</div>{% endif %}</div>
    {% paginate collection.products by 12 %}
    <div class="product-grid">{% for product in collection.products %}{% render 'product-card', product: product %}{% endfor %}</div>
    {% if paginate.pages > 1 %}<div class="row">{% if paginate.previous %}<a class="btn ghost btn-sm" href="{{ paginate.previous.url }}">{{ 'general.pagination.previous' | t }}</a>{% endif %}{% if paginate.next %}<a class="btn ghost btn-sm" href="{{ paginate.next.url }}">{{ 'general.pagination.next' | t }}</a>{% endif %}</div>{% endif %}
    {% endpaginate %}
  </div>
</section>
{% schema %}{ "name": "Colecție", "settings": [] }{% endschema %}
