{%- assign col = collections[section.settings.collection] -%}
<section class="band{% if section.settings.style == 'dark' %}{% else %} paper{% endif %}" id="{{ section.settings.anchor | default: 'sesiuni' }}"{% if section.settings.style != 'dark' %} style="padding-top:0"{% endif %}>
  <div class="in stack" style="gap:32px">
    <div class="stack"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.title }}</h2><p class="lead muted">{{ section.settings.text }}</p></div>
    {%- if col != blank and col.products.size > 0 -%}
    <div class="product-grid">{% for product in col.products limit: 6 %}{% render 'product-card', product: product %}{% endfor %}</div>
    {%- endif -%}
    {%- if section.blocks.size > 0 -%}
    <div class="doors">
      {% for block in section.blocks %}
        {% assign product = all_products[block.settings.product] %}
        <div class="door" {{ block.shopify_attributes }}>
          <span class="tag">{{ block.settings.tag }}</span><h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
          <ul>{% assign items = block.settings.bullets | newline_to_br | split: '<br />' %}{% for it in items %}<li>{{ it | strip }}</li>{% endfor %}</ul>
          <p class="price">{% if product != blank %}{{ product.price | money_without_trailing_zeros }}{% else %}{{ block.settings.price }}{% endif %}<small> {{ block.settings.price_note }}</small></p>
          <a class="btn ghost" href="{% if product != blank %}{{ product.url }}{% else %}{{ block.settings.url }}{% endif %}">{{ block.settings.cta }}</a>
        </div>
      {% endfor %}
    </div>
    {%- endif -%}
    {%- if section.settings.cta_label != blank -%}<div class="row"><a class="btn" href="{{ section.settings.cta_url | default: col.url }}">{{ section.settings.cta_label }} →</a></div>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Sesiuni / produse",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Supratitlu", "default": "Sesiuni individuale" },
    { "type": "text", "id": "title", "label": "Titlu", "default": "Față în față sau pe video call, pe ce ai nevoie" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Alegi ziua și ora din calendarul meu, plătești cu cardul și locul e al tău." },
    { "type": "text", "id": "anchor", "label": "Ancoră (id pentru linkuri din meniu)", "default": "sesiuni" },
    { "type": "select", "id": "style", "label": "Fundal", "options": [{ "value": "paper", "label": "Alb" }, { "value": "dark", "label": "Negru" }], "default": "paper" },
    { "type": "collection", "id": "collection", "label": "Colecție de produse (afișează grila de produse)" },
    { "type": "text", "id": "cta_label", "label": "Buton final (opțional)" },
    { "type": "text", "id": "cta_url", "label": "Link buton final" }
  ],
  "max_blocks": 6,
  "blocks": [{ "type": "session", "name": "Sesiune", "settings": [
    { "type": "text", "id": "tag", "label": "Etichetă" },
    { "type": "text", "id": "title", "label": "Titlu" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "textarea", "id": "bullets", "label": "Puncte (unul pe rând)" },
    { "type": "product", "id": "product", "label": "Produs (prețul și linkul vin de aici)" },
    { "type": "text", "id": "price", "label": "Preț afișat manual (dacă nu e produs)" },
    { "type": "text", "id": "price_note", "label": "Notă preț" },
    { "type": "text", "id": "cta", "label": "Buton", "default": "Alege data" },
    { "type": "text", "id": "url", "label": "Link (dacă nu e produs)" }
  ]}],
  "presets": [{ "name": "Sesiuni individuale", "blocks": [
    { "type": "session", "settings": { "tag": "Live · Sibiu", "title": "Sesiune de posing", "text": "Lucrăm față în față la pozele obligatorii, tranziții și prezentare, pe categoria ta.", "bullets": "Față în față, în Sibiu\nPozele obligatorii, tranziții, prezentare\nRezervi și plătești online", "price": "300 lei", "price_note": "/ 30 de minute", "cta": "Alege data", "url": "/products/posing-live-sibiu" } },
    { "type": "session", "settings": { "tag": "Online", "title": "Posing pe video call", "text": "Aceeași sesiune, pe video call. Linkul îl primești în chat, înainte de ora rezervată.", "bullets": "Pe video call, de oriunde\nPozele obligatorii, tranziții, prezentare\nRezervi și plătești online", "price": "200 lei", "price_note": "/ 30 de minute", "cta": "Alege data", "url": "/products/posing-online" } },
    { "type": "session", "settings": { "tag": "Online", "title": "Consultație video", "text": "Întrebări și răspunsuri pe ce te frământă: peak week, suplimente, plan, nelămuriri.", "bullets": "Pe video call, cu mine\nPeak week, suplimente, plan, întrebări\nRezervi și plătești online", "price": "400 lei", "price_note": "/ 30 de minute", "cta": "Alege data", "url": "/products/consultatie-video" } }
  ]}]
}
{% endschema %}
