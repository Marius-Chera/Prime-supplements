<section class="band"><div class="in narrow stack" style="gap:20px;max-width:480px">
  <h1 style="font-size:clamp(30px,5vw,48px)">{{ 'customer.activate.title' | t }}</h1>
  {% form 'activate_customer_password', class: 'stack' %}
    {{ form.errors | default_errors }}
    <div class="field"><label for="ActivatePassword">{{ 'customer.reset.password' | t }}</label><input id="ActivatePassword" type="password" name="customer[password]" autocomplete="new-password" required></div>
    <div class="field"><label for="ActivatePasswordConfirm">{{ 'customer.reset.confirm' | t }}</label><input id="ActivatePasswordConfirm" type="password" name="customer[password_confirmation]" autocomplete="new-password" required></div>
    <div class="row"><button class="btn" type="submit">{{ 'customer.activate.submit' | t }}</button><button class="btn ghost" type="submit" name="decline">{{ 'customer.activate.decline' | t }}</button></div>
  {% endform %}
</div></section>
