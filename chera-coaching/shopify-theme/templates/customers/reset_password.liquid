<section class="band"><div class="in narrow stack" style="gap:20px;max-width:480px">
  <h1 style="font-size:clamp(30px,5vw,48px)">{{ 'customer.reset.title' | t }}</h1>
  {% form 'reset_customer_password', class: 'stack' %}
    {{ form.errors | default_errors }}
    <div class="field"><label for="ResetPassword">{{ 'customer.reset.password' | t }}</label><input id="ResetPassword" type="password" name="customer[password]" autocomplete="new-password" required></div>
    <div class="field"><label for="ResetPasswordConfirm">{{ 'customer.reset.confirm' | t }}</label><input id="ResetPasswordConfirm" type="password" name="customer[password_confirmation]" autocomplete="new-password" required></div>
    <button class="btn" type="submit">{{ 'customer.reset.submit' | t }}</button>
  {% endform %}
</div></section>
