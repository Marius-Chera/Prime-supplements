{% layout none %}<!doctype html>
<html lang="ro"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>{{ shop.name }}</title>{{ content_for_header }}{{ 'theme.css' | asset_url | stylesheet_tag }}<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700;800&family=Barlow:wght@400;500;600&display=swap"></head>
<body><section class="band"><div class="in narrow stack center" style="gap:20px;padding-block:80px">
  <a class="brand" href="/">Chera <b>Protocol</b></a>
  <h1 style="font-size:clamp(36px,6vw,64px)">{{ 'general.password.title' | t }}</h1>
  <p class="lead muted">{{ 'general.password.text' | t }}</p>
  {% if settings.instagram != blank %}<a class="btn" href="https://www.instagram.com/{{ settings.instagram }}/">Instagram</a>{% endif %}
  {% form 'storefront_password', class: 'row' %}{{ form.errors | default_errors }}<input type="password" name="password" placeholder="Parolă" style="padding:12px;border:1px solid var(--line);border-radius:6px;background:var(--bg-2);color:var(--fg)"><button class="btn btn-sm" type="submit">Intră</button>{% endform %}
</div></section></body></html>
