arget.getAttribute('href') || '';\n      var text = (target.innerText || target.textContent || '').substring(0, 100).toLowerCase();\n\n      // Track product/collection links\n      if (href.includes('/products/') || href.includes('/collections/')) {\n        track('cta_click', { url: href, text: text, type: 'product_link' });\n      }\n      // Track external links\n      else if (href.startsWith('http') && !href.includes(window.location.hostname)) {\n        track('cta_click', { url: href, text: text, type: 'external_link' });\n      }\n      // Track Add to Cart buttons\n      else if (text.includes('add to cart') || text.includes('add to bag') ||\n               target.closest('form[action*=\"/cart/add\"]') ||\n               target.getAttribute('name') === 'add' ||\n               target.classList.contains('product-form__submit') ||\n               target.classList.contains('add-to-cart')) {\n        track('add_to_cart', { text: text, productUrl: window.location.href });\n      }\n      // Track Buy Now buttons\n      else if (text.includes('buy now') || text.includes('buy it now') ||\n               target.closest('.shopify-payment-button')) {\n        track('buy_now', { text: text, productUrl: window.location.href });\n      }\n    }\n  });\n\n  // Track Shopify cart events via AJAX interception\n  var origFetch = window.fetch;\n  window.fetch = function(url, options) {\n    var result = origFetch.apply(this, arguments);\n    if (typeof url === 'string') {\n      if (url.includes('/cart/add')) {\n        track('add_to_cart', { method: 'ajax', url: url });\n      } else if (url.includes('/checkouts') || url.includes('/checkout')) {\n        track('checkout_start', { method: 'ajax', url: url });\n      }\n    }\n    return result;\n  };\n\n  // Track form submissions (for non-AJAX add to cart)\n  document.addEventListener('submit', function(e) {\n    var form = e.target;\n    var action = form.getAttribute('action') || '';\n    if (action.includes('/cart/add'))