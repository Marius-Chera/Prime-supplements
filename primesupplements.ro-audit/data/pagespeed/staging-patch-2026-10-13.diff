diff -ruN orig/sections/main-article.liquid stg/sections/main-article.liquid
--- orig/sections/main-article.liquid	2026-10-13 10:10:07.918441291 +0000
+++ stg/sections/main-article.liquid	2026-10-13 10:51:56.905340357 +0000
@@ -114,6 +114,102 @@
           | replace: 'href="https://bloggenauto.com" target="_blank" rel="noopener"', 'href="https://bloggenauto.com" rel="nofollow sponsored noopener"'
           | replace: 'rel="noopener" href="https://bloggenauto.com" target="_blank"', 'rel="nofollow sponsored noopener" href="https://bloggenauto.com"'
         -%}
+        {%- comment -%}
+          Accessibility (2026-10-13): many bodies jump from h2 (or from the h1 title) straight to h4 for the product and
+          author cards. The tags and their styling stay exactly as written; an aria-level is added only where needed, so
+          the outline announced by screen readers (and checked by Lighthouse) never skips a level. Each heading is placed
+          one level below the closest previous heading with a smaller tag (open_1..open_6 hold the announced level of the
+          open heading of each tag, the article title being the open h1), so headings with the same tag stay siblings.
+        {%- endcomment -%}
+        {%- liquid
+          assign heading_digits = '1,2,3,4,5,6' | split: ','
+          assign heading_parts = article_body | split: '<h'
+          assign open_1 = 1
+          assign open_2 = 0
+          assign open_3 = 0
+          assign open_4 = 0
+          assign open_5 = 0
+          assign open_6 = 0
+          capture article_body
+            for part in heading_parts
+              if forloop.first
+                echo part
+                continue
+              endif
+              assign level_char = part | slice: 0
+              assign next_char = part | slice: 1
+              assign is_heading = false
+              if heading_digits contains level_char
+                if next_char == ' ' or next_char == '>'
+                  assign is_heading = true
+                endif
+              endif
+              if is_heading and part contains 'aria-level'
+                assign is_heading = false
+              endif
+              unless is_heading
+                echo '<h' | append: part
+                continue
+              endunless
+              assign tag_level = level_char | plus: 0
+              assign parent_level = 0
+              if tag_level > 1 and open_1 > 0
+                assign parent_level = open_1
+              endif
+              if tag_level > 2 and open_2 > 0
+                assign parent_level = open_2
+              endif
+              if tag_level > 3 and open_3 > 0
+                assign parent_level = open_3
+              endif
+              if tag_level > 4 and open_4 > 0
+                assign parent_level = open_4
+              endif
+              if tag_level > 5 and open_5 > 0
+                assign parent_level = open_5
+              endif
+              assign announced_level = parent_level | plus: 1
+              if announced_level > tag_level
+                assign announced_level = tag_level
+              endif
+              case tag_level
+                when 1
+                  assign open_1 = announced_level
+                  assign open_2 = 0
+                  assign open_3 = 0
+                  assign open_4 = 0
+                  assign open_5 = 0
+                  assign open_6 = 0
+                when 2
+                  assign open_2 = announced_level
+                  assign open_3 = 0
+                  assign open_4 = 0
+                  assign open_5 = 0
+                  assign open_6 = 0
+                when 3
+                  assign open_3 = announced_level
+                  assign open_4 = 0
+                  assign open_5 = 0
+                  assign open_6 = 0
+                when 4
+                  assign open_4 = announced_level
+                  assign open_5 = 0
+                  assign open_6 = 0
+                when 5
+                  assign open_5 = announced_level
+                  assign open_6 = 0
+                when 6
+                  assign open_6 = announced_level
+              endcase
+              if announced_level < tag_level
+                assign rest = part | slice: 1, part.size
+                echo '<h' | append: level_char | append: ' aria-level="' | append: announced_level | append: '"' | append: rest
+              else
+                echo '<h' | append: part
+              endif
+            endfor
+          endcapture
+        -%}
         {{ article_body }}
       </div>
 
