{%- comment -%}
  snippets/schema-collection.liquid (v2, SEO audit 2026-10-12)
  Fixes: | json everywhere; description never empty (falls back to a generated sentence until the
  23 collections get real descriptions); numberOfItems = collection.all_products_count (the old
  snippet reported the paginated page size, e.g. 24 for "All Products" which has 195 products,
  while listing only 20); ListItem positions offset by the current page; BreadcrumbList for the
  collection; @id/isPartOf link to the WebSite node. Rendered from sections/main-collection.liquid.
{%- endcomment -%}
{%- if collection -%}
{%- liquid
  assign description = collection.description | strip_html | strip_newlines | strip | truncate: 300
  if description == blank
    assign description = collection.title | append: ': ' | append: collection.all_products_count | append: ' produse Prime Supplements, livrare în România în 1-3 zile lucrătoare.'
  endif
  assign per_page = 24
  assign offset = current_page | default: 1 | minus: 1 | times: per_page
-%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": {{ canonical_url | json }},
      "url": {{ canonical_url | json }},
      "name": {{ collection.title | json }},
      "description": {{ description | json }},
      "inLanguage": "ro",
      "isPartOf": { "@id": "https://primesupplements.ro/#website" },
      {%- if collection.image %}
      "image": {{ collection.image | image_url: width: 1200 | prepend: 'https:' | json }},
      {%- endif %}
      "breadcrumb": { "@id": {{ canonical_url | append: '#breadcrumb' | json }} },
      "mainEntity": {
        "@type": "ItemList",
        "numberOfItems": {{ collection.all_products_count | json }},
        "itemListOrder": "https://schema.org/ItemListOrderAscending",
        "itemListElement": [
          {%- for product in collection.products -%}
          {
            "@type": "ListItem",
            "position": {{ forloop.index | plus: offset }},
            "url": {{ request.origin | append: product.url | json }},
            "name": {{ product.title | json }}
            {%- if product.featured_image -%},
            "image": {{ product.featured_image | image_url: width: 600 | prepend: 'https:' | json }}
            {%- endif %}
          }{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ]
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": {{ canonical_url | append: '#breadcrumb' | json }},
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Acasă", "item": {{ request.origin | append: '/' | json }} },
        { "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ canonical_url | json }} }
      ]
    }
  ]
}
</script>
{%- endif -%}
