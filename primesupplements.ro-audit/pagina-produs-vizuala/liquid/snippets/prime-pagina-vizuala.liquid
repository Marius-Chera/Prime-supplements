{%- comment -%}
  Prime – pagina de produs vizuală, v3 (15.11.2026): randată ÎN tab-ul „Despre produs” (cerut de Marius, ca la Genius).
  Folosire: {% render 'prime-pagina-vizuala', product: product %} (din blocul „Liquid code” al secțiunii tabs).
  Datele: metafield-ul JSON product.metafields.prime.pagina_vizuala (repo: pagina-produs-vizuala/date/*.json).
  Fără metafield nu afișează nimic. Tema randează conținutul tab-urilor de două ori (acordeon pe telefon + tab-uri pe
  desktop), deci nu folosim id-uri: scriptul lucrează pe toate copiile cu data-ppv-product, o singură dată pe pagină.
{%- endcomment -%}
{%- assign d = product.metafields.prime.pagina_vizuala.value -%}
{%- if d != blank and d.titlu != blank -%}
{{ 'prime-pagina-vizuala.css' | asset_url | stylesheet_tag }}
{%- assign v = product.selected_or_first_available_variant -%}
{%- assign tema = 'rosu' -%}
{%- case d.tema -%}
  {%- when 'albastru', 'verde', 'mov', 'portocaliu', 'roz' -%}{%- assign tema = d.tema -%}
{%- endcase -%}
<section class="ppv ppv--{{ tema }}" data-ppv-product="{{ product.id }}">
  <div class="ppv__wrap">

    <div class="ppv-panel ppv-hero">
      <div>
        {%- if d.badge.size > 0 -%}
          <p class="ppv-badge">{% for b in d.badge %}<span>{{ b | escape }}</span>{% endfor %}</p>
        {%- endif -%}
        <h2>{{ d.titlu | escape }}</h2>
        {%- if d.intro != blank -%}
          <p class="ppv-intro">{{ d.intro | escape | replace: '[[', '<strong class="ppv-hl">' | replace: ']]', '</strong>' }}</p>
        {%- endif -%}
        {%- if d.etichete.size > 0 -%}
          <ul class="ppv-tags">{% for t in d.etichete %}<li>{{ t | escape }}</li>{% endfor %}</ul>
        {%- endif -%}
        {%- if d.cifre.size > 0 -%}
          <ul class="ppv-stats">
            {%- for c in d.cifre limit: 4 -%}
              <li class="ppv-stat">
                <div class="ppv-stat__v">{{ c.valoare | escape }}{% if c.unitate != blank %}<small>{{ c.unitate | escape }}</small>{% endif %}</div>
                <div class="ppv-stat__l">{{ c.eticheta | escape }}</div>
              </li>
            {%- endfor -%}
          </ul>
          {%- if d.nota_cifre != blank -%}<p class="ppv-footnote">{{ d.nota_cifre | escape }}</p>{%- endif -%}
        {%- endif -%}
      </div>

      {%- if d.imagine.url != blank -%}
        {%- assign src = d.imagine.url | append: '' -%}
        {%- if src contains '?' -%}{%- assign sep = '&' -%}{%- else -%}{%- assign sep = '?' -%}{%- endif -%}
        <figure class="ppv-media">
          <img src="{{ src | append: sep | append: 'width=900' }}"
               srcset="{{ src | append: sep }}width=480 480w, {{ src | append: sep }}width=720 720w, {{ src | append: sep }}width=900 900w, {{ src | append: sep }}width=1200 1200w"
               sizes="(max-width: 920px) 90vw, 460px" alt="{{ d.imagine.alt | escape }}" loading="lazy" width="900" height="1125">
      {%- else -%}
        {%- assign img = v.featured_image | default: product.featured_image -%}
        <figure class="ppv-media ppv-media--produs">
          {%- if img -%}{{ img | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(max-width: 920px) 90vw, 460px', widths: '360,540,720,900', alt: img.alt }}{%- endif -%}
      {%- endif -%}
          {%- if d.mini_carduri.size > 0 -%}
            <div class="ppv-minis">
              {%- for m in d.mini_carduri limit: 2 -%}
                <div class="ppv-mini"><b>{{ m.titlu | escape }}</b><span>{{ m.text | escape }}</span></div>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </figure>
    </div>

    <div class="ppv-two">
      {%- if d.card_formula -%}
        <div class="ppv-card ppv-card--tint">
          <span class="ppv-kicker">{{ d.card_formula.eticheta | escape }}</span>
          <h3>{{ d.card_formula.titlu | escape }}</h3>
          <ul class="ppv-rows">
            {%- for r in d.card_formula.randuri -%}<li><span>{{ r.nume | escape }}</span><b>{{ r.valoare | escape }}</b></li>{%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
      {%- if d.card_puncte -%}
        <div class="ppv-card">
          <span class="ppv-kicker">Pe scurt</span>
          <h3>{{ d.card_puncte.titlu | escape }}</h3>
          <ul class="ppv-checks">{% for p in d.card_puncte.puncte %}<li>{{ p | escape }}</li>{% endfor %}</ul>
        </div>
      {%- endif -%}
    </div>

    {%- if d.carduri_ingrediente.carduri.size > 0 -%}
      <div>
        <div class="ppv-head">
          <span class="ppv-kicker">Formula</span>
          <h3>{{ d.carduri_ingrediente.titlu | escape }}</h3>
        </div>
        <div class="ppv-grid">
          {%- for c in d.carduri_ingrediente.carduri -%}
            <div class="ppv-ing">
              <span class="ppv-ing__code" aria-hidden="true">{{ c.cod | escape }}</span>
              <h4>{{ c.titlu | escape }}</h4>
              <p>{{ c.text | escape }}</p>
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    {%- if d.arome.size > 0 or d.mod_de_folosire != blank -%}
      <div class="ppv-two">
        {%- if d.arome.size > 0 -%}
          <div class="ppv-card">
            <span class="ppv-kicker">Arome</span>
            <h3>{{ d.arome.size }} {% if d.arome.size == 1 %}aromă{% else %}arome{% endif %}</h3>
            <ul class="ppv-flav">
              {%- for a in d.arome -%}
                <li data-ppv-flavour="{{ a.varianta | escape }}"{% if v.title == a.varianta %} aria-current="true"{% endif %}>
                  <b>{{ a.nume | escape }}</b><span>{{ a.nota | escape }}</span>
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
        {%- if d.mod_de_folosire != blank -%}
          <div class="ppv-card ppv-card--tint">
            <span class="ppv-kicker">Mod de folosire</span>
            <h3>Cum îl prepari</h3>
            <p>{{ d.mod_de_folosire | escape }}</p>
            <p class="ppv-note">Supliment alimentar. Nu înlocuiește o dietă variată și echilibrată și un stil de viață sănătos.</p>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%}
      „Curiozități” (v4, 15.11.2026): un singur H2, întrebări ca H3 (răspuns direct în prima frază), text pe server.
      Datele: metafield-ul JSON prime.curiozitati (separat, ca să nu rescriem toată pagina) sau, dacă lipsește, d.curiozitati = {titlu, intro, sectiuni:[{intrebare, raspuns}], surse:[{text, url}]}.
      Răspunsul poate avea mai multe paragrafe, despărțite prin „ ¶ ” (pilcrow între spații).
    {%- endcomment -%}
    {%- assign cur = product.metafields.prime.curiozitati.value -%}
    {%- if cur == blank -%}{%- assign cur = d.curiozitati -%}{%- endif -%}
    {%- if cur.sectiuni.size > 0 -%}
      <div class="ppv-cur">
        <div class="ppv-head">
          <span class="ppv-kicker">Curiozități</span>
          <h2 class="ppv-cur__t">{{ cur.titlu | default: 'Lucruri interesante' | escape }}</h2>
          {%- if cur.intro != blank -%}<p class="ppv-cur__intro">{{ cur.intro | escape }}</p>{%- endif -%}
        </div>
        <div class="ppv-cur__grid">
          {%- for s in cur.sectiuni -%}
            <div class="ppv-q">
              <h3>{{ s.intrebare | escape }}</h3>
              {%- assign paras = s.raspuns | split: ' ¶ ' -%}
              {%- for para in paras -%}<p>{{ para | strip | escape }}</p>{%- endfor -%}
            </div>
          {%- endfor -%}
        </div>
        {%- if cur.surse.size > 0 -%}
          <p class="ppv-cur__src">Surse:
            {% for s in cur.surse -%}
              <a href="{{ s.url | escape }}" target="_blank" rel="noopener">{{ s.text | escape }}</a>{% unless forloop.last %}; {% endunless %}
            {%- endfor -%}
          </p>
        {%- endif -%}
      </div>
    {%- endif -%}

  </div>
</section>

{%- comment -%}
  La schimbarea aromei: aroma evidențiată + poza variantei (doar când nu e setată o poză din ședință).
  Impact 6.7.1 trimite variant:change din <form> (verificat 15.11: detail.variant cu id, title, featured_image).
  Se ia în seamă doar o variantă a acestui produs (pagina mai are formulare de la alte produse).
{%- endcomment -%}
<script>
  (function () {
    if (window.__ppvInit) return; window.__ppvInit = true;
    var imgs = {{ product.variants | map: 'featured_image' | json }};
    var titles = {{ product.variants | map: 'title' | json }};
    var ids = {{ product.variants | map: 'id' | json }};
    function apply(variant) {
      if (!variant || ids.indexOf(variant.id) === -1) return;
      document.querySelectorAll('.ppv[data-ppv-product="{{ product.id }}"]').forEach(function (root) {
        root.querySelectorAll('[data-ppv-flavour]').forEach(function (li) {
          li.setAttribute('aria-current', li.getAttribute('data-ppv-flavour') === variant.title ? 'true' : 'false');
        });
        var el = root.querySelector('.ppv-media--produs img');
        if (!el) return;
        var i = titles.indexOf(variant.title);
        var src = variant.featured_image ? variant.featured_image.src : (i > -1 && imgs[i] ? imgs[i].src : null);
        if (src) { el.removeAttribute('srcset'); el.src = src + (src.indexOf('?') > -1 ? '&' : '?') + 'width=900'; }
      });
    }
    document.addEventListener('variant:change', function (e) { apply(e.detail && e.detail.variant); });
  })();
</script>
{%- endif -%}
