{%- comment -%}
------------------------------------------------------------------------------------------------------------------------
NOTE TO DEVELOPERS: welcome to Impact theme! We hope that you will enjoy editing this theme as much as we did for
  developing it. We have put a lot of work to make this theme as developer friendly as possible by offering you
  hooks to integrate into critical parts of the theme. You will find the complete technical documentation (including
  all events, dependencies...) in the "documentation.txt" file, located in the Assets folder.
------------------------------------------------------------------------------------------------------------------------
{%- endcomment -%}

<!doctype html>

<html lang="{{ request.locale.iso_code }}" dir="{% render 'direction' %}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, height=device-height, minimum-scale=1.0, maximum-scale=1.0">
    <meta name="theme-color" content="{{ settings.header_background }}">
    {%- comment -%}SEO (2026-10-12): charset/viewport first (charset must sit in the first 1024 bytes; the viewport keeps the live maximum-scale, because removing it makes iOS zoom on focus of inputs smaller than 16px, a visible change left to the owner), title gets the brand suffix, utility/transactional pages are noindex.{%- endcomment -%}
    {%- liquid
      assign seo_title = page_title
      if seo_title == blank
        assign seo_title = shop.name
      endif
      assign has_brand = false
      if seo_title contains 'Prime Supplements' or seo_title contains 'PRIME Supplements' or seo_title contains 'PRIME SUPPLEMENTS'
        assign has_brand = true
      endif
      if request.page_type == 'index'
        assign seo_title = 'Suplimente nutritive, proteine și creatină | Prime Supplements'
      elsif has_brand == false and seo_title.size <= 40
        assign seo_title = seo_title | append: ' | Prime Supplements'
      endif
      if current_page != 1
        assign page_label = 'general.page' | t: page: current_page
        assign seo_title = seo_title | append: ' – ' | append: page_label
      endif
      assign seo_description = page_description
      if request.page_type == 'index'
        assign seo_description = 'Magazin online de suplimente nutritive pentru sport: creatină, proteine din zer, pre-workout, aminoacizi, vitamine și echipament de sală MNX. Livrare rapidă în toată România.'
      endif

      assign noindex_page = false
      assign utility_collections = 'all,cele-mai-vandute,lansate-recent,11-tva,frontpage,reduceri,vendors,types' | split: ','
      if request.page_type == 'collection' and utility_collections contains collection.handle
        assign noindex_page = true
      endif
      if request.page_type == 'page' and page.handle == 'thank-you'
        assign noindex_page = true
      endif
      if request.page_type == 'search' or request.page_type == 'cart' or request.page_type == 'password'
        assign noindex_page = true
      endif
      if request.page_type contains 'customers/'
        assign noindex_page = true
      endif
      comment
        SEO (2026-10-13): tag-filtered listings (/collections/<handle>/<tag>, /blogs/news/tagged/<tag>) repeat the parent title and content.
      endcomment
      if current_tags != blank
        if request.page_type == 'collection' or request.page_type == 'blog'
          assign noindex_page = true
        endif
      endif
      comment
        SEO (2026-10-13): resources hidden with the seo.hidden metafield already get noindex,nofollow from Shopify; do not emit a second, conflicting robots tag for them.
      endcomment
      if request.page_type == 'collection' and collection.metafields.seo.hidden.value == 1
        assign noindex_page = false
      endif
      if request.page_type == 'page' and page.metafields.seo.hidden.value == 1
        assign noindex_page = false
      endif
    -%}
    <title>{{ seo_title }}</title>

    {%- if seo_description != blank -%}
      <meta name="description" content="{{ seo_description | escape }}">
    {%- endif -%}
    {%- if noindex_page -%}
      <meta name="robots" content="noindex, follow">
    {%- endif -%}

    <link rel="canonical" href="{{ canonical_url }}">
    {% render 'schema-organization' %}
    {%- if request.page_type == 'page' -%}{% render 'schema-page' %}{%- endif -%}
    <script src="{{ 'pandectes-rules.js' | file_url }}"></script>

    {%- if settings.favicon -%}
      <link rel="shortcut icon" href="{{ settings.favicon | image_url: width: 96 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180 }}">
    {%- endif -%}

    {%- comment -%}Few prefetch to increase performance on commonly used third-parties{%- endcomment -%}
    <link rel="preconnect" href="https://cdn.shopify.com">
    <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>

    {%- unless settings.heading_font.system? -%}
      <link rel="preload" href="{{ settings.heading_font | font_url }}" as="font" type="font/woff2" crossorigin>
    {%- endunless -%}

    {%- unless settings.text_font.system? -%}
      <link rel="preload" href="{{ settings.text_font | font_url }}" as="font" type="font/woff2" crossorigin>
    {%- endunless -%}

    {%- render 'social-meta-tags' -%}
    {%- comment -%}{%- render 'microdata-schema' -%}{%- endcomment -%}
    {%- render 'css-variables' -%}
    {%- render 'js-variables' -%}

    <script type="importmap">
      {%- comment -%}On Safari 16.3 and lower, a polyfill is used to load importmap{%- endcomment -%}
      {
        "imports": {
          "vendor": "{{ 'vendor.min.js' | asset_url }}",
          "theme": "{{ 'theme.js' | asset_url }}",
          "photoswipe": "{{ 'photoswipe.min.js' | asset_url }}"
        }
      }
    </script>

    <script type="module" src="{{ 'vendor.min.js' | asset_url }}"></script>
    <script type="module" src="{{ 'theme.js' | asset_url }}"></script>

    {{ content_for_header }}

    {{- 'theme.css' | asset_url | stylesheet_tag: preload: true -}}
    {{ 'bss-custom.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'bss-custom.js' | asset_url }}" defer></script>
  </head>

  <body class="{% if settings.zoom_image_on_hover %}zoom-image--enabled{% endif %}">
    {%- render 'shadow-dom-templates' -%}

    <a href="#main" class="skip-to-content sr-only">{{ 'general.accessibility.skip_to_content' | t }}</a>

    {%- if request.page_type != 'password' -%}
      {%- sections 'header-group' -%}
      {%- sections 'overlay-group' -%}

      {%- if settings.cart_type == 'popover' -%}
        <cart-notification-drawer open-from="bottom" class="quick-buy-drawer drawer"></cart-notification-drawer>
      {%- endif -%}
    {%- endif -%}

    {%- if request.page_type == 'customers/account' or request.page_type == 'customers/order' or request.page_type == 'customers/addresses' -%}
      {%- section 'account-banner' -%}
    {%- endif -%}

    <main role="main" id="main" class="anchor">
      {{ content_for_layout }}

      {%- comment -%}
      IMPLEMENTATION NOTE: due to the very complex logic of margin/padding collapsing in Impact, the footer group is
      added into the main element to ensure that dynamic sections added into the footer group are properly laid out.
      {%- endcomment -%}
      {%- if request.page_type != 'password' -%}
        {%- sections 'footer-group' -%}
      {%- endif -%}
    </main>
  </body>
</html>