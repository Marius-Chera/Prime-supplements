{%- comment -%}
  Prime Coș – perechile „Merge perfect cu” (alese de Claude la cererea lui Marius, 15.11.2026).
  Întoarce o listă de handle-uri separate prin virgulă, în ordinea preferinței. Cele fără stoc sunt sărite la afișare,
  de aceea fiecare listă are rezerve. Parametru: p (produsul).
{%- endcomment -%}
{%- liquid
  assign h = p.handle
  case h
    when 'creatina-creapure', 'creatina-monohidrat-micronized-300g-fara-aroma', 'creatine-ready-to-go-plicuri-prime-supplements'
      echo 'magneziu-bisglicinat-80-caps,glycerol-max-pump-500g-125-serv,eaa-aminoacizi-esentiali,prime-whey-1000g,recovery-glutamin'
    when 'prime-whey-1000g', 'prime-whey-2000g', 'pure-isolate-2000g', 'prime-whey-go'
      echo 'creatina-creapure,crema-de-orez-biscuiti-cu-crema,unt-de-arahide,eaa-aminoacizi-esentiali,instant-oat-cream-800g-25-serv'
    when 'emperor-mass_3000g'
      echo 'creatina-creapure,unt-de-arahide,instant-oat-cream-800g-25-serv,recovery-glutamin'
    when 'nitrox', 'combat-pro', 'combat-pro-2-0-660g-30-serv', 'nitrox-no-stim'
      echo 'creatina-creapure,glycerol-max-pump-500g-125-serv,eaa-aminoacizi-esentiali,cluster-bomb-1000g'
    when 'energy-pump'
      echo 'creatina-creapure,eaa-aminoacizi-esentiali,taurine-80-caps,baton-proteic-caramel-sarat'
    when 'glycerol-max-pump-500g-125-serv'
      echo 'creatina-creapure,nitrox,potassium-complex-80-caps,eaa-aminoacizi-esentiali'
    when 'eaa-aminoacizi-esentiali'
      echo 'recovery-glutamin,creatina-creapure,cluster-bomb-1000g,glycerol-max-pump-500g-125-serv'
    when 'recovery-bcaa-500g', 'recovery-glutamin'
      echo 'eaa-aminoacizi-esentiali,creatina-creapure,prime-whey-1000g,magneziu-bisglicinat-80-caps'
    when 'cluster-bomb-1000g'
      echo 'eaa-aminoacizi-esentiali,creatina-creapure,glycerol-max-pump-500g-125-serv,nitrox'
    when 'thermo-core-120-caps'
      echo 'l-carnitine-1000-80-caps,water-out-120-caps,fiber-blood-orange,supliment-alimentar-chromium-picolinate-80-caps'
    when 'water-out-120-caps', 'water-out-500-ml'
      echo 'thermo-core-120-caps,potassium-complex-80-caps,l-carnitine-1000-80-caps,fiber-blood-orange'
    when 'l-carnitine-1000-80-caps'
      echo 'thermo-core-120-caps,water-out-120-caps,fat-burning-booster,eaa-aminoacizi-esentiali'
    when 'fat-burning-booster'
      echo 'l-carnitine-1000-80-caps,thermo-core-120-caps,water-out-120-caps,energy-pump'
    when 'supliment-alimentar-chromium-picolinate-80-caps', 'scortisoara-ceylon-bio-200g'
      echo 'citrus-bergamot,fiber-blood-orange,magneziu-bisglicinat-80-caps,thermo-core-120-caps'
    when 'vitamina-d3-k2'
      echo 'magneziu-bisglicinat-80-caps,omega-3,zinc-citrate-80-caps,vitamin-c-1000-80-caps'
    when 'magneziu-bisglicinat-80-caps', 'magnesium-citrate-80-caps'
      echo 'vitamina-d3-k2,zinc-citrate-80-caps,ashwagandha-ksm-66,omega-3'
    when 'zinc-citrate-80-caps'
      echo 'magneziu-bisglicinat-80-caps,vitamina-d3-k2,vitamin-c-1000-80-caps,ashwagandha-ksm-66'
    when 'vitamin-c-1000-80-caps'
      echo 'zinc-citrate-80-caps,vitamina-d3-k2,nac-80-caps,omega-3'
    when 'omega-3'
      echo 'vitamina-d3-k2,magneziu-bisglicinat-80-caps,coenzima-q10-80-caps,turmeric-extract-80-caps'
    when 'daily-vitamin-formula'
      echo 'omega-3,magneziu-bisglicinat-80-caps,ashwagandha-ksm-66,vitamina-d3-k2'
    when 'potassium-complex-80-caps'
      echo 'magneziu-bisglicinat-80-caps,water-out-120-caps,glycerol-max-pump-500g-125-serv,vitamina-d3-k2'
    when 'taurine-80-caps'
      echo 'magneziu-bisglicinat-80-caps,eaa-aminoacizi-esentiali,creatina-creapure,potassium-complex-80-caps'
    when 'ashwagandha-ksm-66'
      echo 'magneziu-bisglicinat-80-caps,zinc-citrate-80-caps,vitamina-d3-k2,daily-vitamin-formula'
    when 'turmeric-extract-80-caps'
      echo 'omega-3,complete-collagen,nac-80-caps,vitamina-d3-k2'
    when 'complete-collagen'
      echo 'vitamin-c-1000-80-caps,turmeric-extract-80-caps,omega-3,magneziu-bisglicinat-80-caps'
    when 'nac-80-caps'
      echo 'silimarina-80-caps,vitamin-c-1000-80-caps,zinc-citrate-80-caps,omega-3'
    when 'silimarina-80-caps'
      echo 'nac-80-caps,spirulina-80-caps,fiber-blood-orange,omega-3'
    when 'spirulina-80-caps'
      echo 'silimarina-80-caps,vitamin-c-1000-80-caps,fiber-blood-orange,omega-3'
    when 'enzima-nattokinaza-80-caps', 'citrus-bergamot', 'coenzima-q10-80-caps'
      echo 'omega-3,citrus-bergamot,coenzima-q10-80-caps,magneziu-bisglicinat-80-caps,enzima-nattokinaza-80-caps'
    when 'testo-revive-500-ml', 'cardio-calm-500-ml'
      echo 'zinc-citrate-80-caps,magneziu-bisglicinat-80-caps,ashwagandha-ksm-66,omega-3'
    when 'fiber-blood-orange'
      echo 'prime-whey-1000g,magneziu-bisglicinat-80-caps,silimarina-80-caps,omega-3'
    when 'instant-oat-cream-800g-25-serv'
      echo 'prime-whey-1000g,unt-de-arahide,crema-de-orez-biscuiti-cu-crema,unt-de-migdale'
    when 'unt-de-arahide', 'unt-de-migdale', 'unt-de-caju'
      echo 'crema-de-orez-biscuiti-cu-crema,instant-oat-cream-800g-25-serv,prime-whey-1000g,crema-de-orez-tort-de-ciocolata'
    when 'baton-proteic-capsuni', 'baton-proteic-caramel-sarat', 'baton-proteic-cocos-si-caramel', 'baton-proteic-ciocolata-fructe-de-padure'
      echo 'baton-proteic-caramel-sarat,baton-proteic-cocos-si-caramel,baton-proteic-capsuni,prime-whey-go,energy-pump'
    when 'pantaloni-trening-barbati-hammer-3-0-prime-negri', 'pantaloni-scurti-waffle-barbati-hammer-3-0-prime-negri', 'tricou-oversized-barbati-hammer-3-0-prime-negru', 'maieu-fitness-barbati-edge-prime-negru'
      echo 'tricou-oversized-barbati-hammer-3-0-prime-negru,pantaloni-trening-barbati-hammer-3-0-prime-negri,pantaloni-scurti-waffle-barbati-hammer-3-0-prime-negri,maieu-fitness-barbati-edge-prime-negru,prosop-negru'
    when 'prosop-negru', 'centura-hardcore', 'sapca-prime', 'shaker-premium-accesorizat-500-ml', 'prime-shaker-customised'
      echo 'prosop-negru,prime-shaker-customised,shaker-premium-accesorizat-500-ml,creatina-creapure,prime-whey-1000g'
    else
      if p.type == 'Cremă de orez și ovăz'
        echo 'prime-whey-1000g,unt-de-arahide,unt-de-migdale,crema-de-orez-biscuiti-cu-crema,crema-de-orez-tort-de-ciocolata'
      elsif p.type == 'Băuturi instant'
        echo 'instant-drink-frutilu-lemon,instant-drink-frutilu-watermelon-10g,instant-drink-frutilu-energy-cranberry-10g,instant-drink-frutilu-cola-10g,eaa-aminoacizi-esentiali'
      elsif p.tags contains 'Îmbrăcăminte' or p.vendor == 'MNX'
        echo 'tricou-oversized-barbati-hammer-3-0-prime-negru,pantaloni-trening-barbati-hammer-3-0-prime-negri,prosop-negru'
      elsif p.tags contains 'pachet'
        echo ''
      else
        echo 'creatina-creapure,omega-3,magneziu-bisglicinat-80-caps,vitamina-d3-k2'
      endif
  endcase
-%}
