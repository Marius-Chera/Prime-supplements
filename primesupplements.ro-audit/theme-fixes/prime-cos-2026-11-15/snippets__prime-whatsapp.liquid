  </svg>
</a>
<style>
  .prime-wa {
    position: fixed;
    right: 10px;
    bottom: 90px;
    z-index: 2147483000;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 55px;
    height: 55px;
    border-radius: 50%;
    background: #2ab540;
    box-shadow: 0 4px 12px rgb(0 0 0 / .25);
    transition: transform .2s ease;
  }
  .prime-wa:hover,
  .prime-wa:focus-visible {
    transform: scale(1.08);
  }
  .prime-wa:focus-visible {
    outline: 3px solid #1a1a1a;
    outline-offset: 3px;
  }
  .consent-pending .prime-wa {
    display: none !important;
  }
  @media print {
    .prime-wa { display: none; }
  }
</style>
