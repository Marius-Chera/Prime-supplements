{%- comment -%}
  Product breadcrumb (JSON-LD). Rewritten 2026-10-12: uses the `json` filter and picks
  the first real category collection of the product instead of product.collections.first,
  which resolved to the automated "All Products" collection.
{%- endcomment -%}
{%- if product -%}
{%- liquid
  assign utility_collections = 'all,cele-mai-vandute,lansate-recent,11-tva,frontpage,reduceri' | split: ','
  assign crumb_collection = nil
  for c in product.collections
    unless utility_collections contains c.handle
      assign crumb_collection = c
      break
    endunless
  endfor
  if crumb_collection == nil and collection
    unless utility_collections contains collection.handle
      assign crumb_collection = collection
    endunless
  endif
-%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Pagina principală", "item": {{ shop.url | append: '/' | json }} },
    {%- if crumb_collection %}
    { "@type": "ListItem", "position": 2, "name": {{ crumb_collection.title | json }}, "item": {{ shop.url | append: crumb_collection.url | json }} },
    { "@type": "ListItem", "position": 3, "name": {{ product.title | json }}, "item": {{ shop.url | append: product.url | json }} }
    {%- else %}
    { "@type": "ListItem", "position": 2, "name": {{ product.title | json }}, "item": {{ shop.url | append: product.url | json }} }
    {%- endif %}
  ]
}
</script>
{%- endif -%}
