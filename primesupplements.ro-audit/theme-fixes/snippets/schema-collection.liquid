{%- comment -%}
  Collection structured data (JSON-LD): CollectionPage + ItemList + BreadcrumbList.
  Rewritten 2026-10-12 with the `json` filter everywhere; the description is only
  emitted when the collection actually has one.
{%- endcomment -%}
{%- if collection -%}
{%- liquid
  assign collection_url = shop.url | append: collection.url
  assign collection_description = collection.description | strip_html | strip_newlines | strip | truncate: 300, ''
-%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": {{ collection_url | append: '#webpage' | json }},
      "name": {{ collection.title | json }},
      {%- if collection_description != blank %}
      "description": {{ collection_description | json }},
      {%- endif %}
      "url": {{ collection_url | json }},
      "inLanguage": "ro",
      "isPartOf": { "@id": {{ shop.url | append: '/#website' | json }} },
      {%- if collection.image %}
      "primaryImageOfPage": { "@type": "ImageObject", "url": {{ collection.image | image_url: width: 1200 | prepend: 'https:' | json }} },
      {%- endif %}
      "mainEntity": {
        "@type": "ItemList",
        "numberOfItems": {{ collection.products_count | json }},
        "itemListElement": [
          {%- for product in collection.products limit: 24 -%}
          {
            "@type": "ListItem",
            "position": {{ forloop.index }},
            "url": {{ shop.url | append: product.url | json }},
            "name": {{ product.title | json }}{%- if product.featured_image -%},
            "image": {{ product.featured_image | image_url: width: 600 | prepend: 'https:' | json }}
            {%- endif %}
          }{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ]
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Pagina principală", "item": {{ shop.url | append: '/' | json }} },
        { "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ collection_url | json }} }
      ]
    }
  ]
}
</script>
{%- endif -%}
