{%- comment -%}
  Product structured data (JSON-LD) for Google merchant listings / product snippets.
  Rewritten 2026-10-12: every string goes through the `json` filter (the previous
  version used `escape`, which does not escape line breaks and produced invalid JSON
  on every product whose description contains a newline). Offers are emitted per
  variant as Offer objects with decimal prices, availability, SKU/GTIN, return policy
  and shipping details (Google merchant-listing requirements). Brand comes from the
  vendor field, category from the product type, ratings from the standard
  reviews.rating / reviews.rating_count metafields (written by Judge.me).
{%- endcomment -%}
{%- if product -%}
{%- liquid
  assign brand_name = product.vendor | strip
  if brand_name == blank or brand_name == 'primesupplements1'
    assign brand_name = 'Prime Supplements'
  endif
  assign product_url = shop.url | append: product.url
  assign plain_description = product.description | strip_html | strip_newlines | strip | truncate: 5000, ''
  if plain_description == blank
    assign plain_description = product.title
  endif
  assign rating_value = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count.value | plus: 0
  assign price_valid_until = 'now' | date: '%s' | plus: 31536000 | date: '%Y-%m-%d'
  assign currency_code = cart.currency.iso_code
  assign first_variant = product.selected_or_first_available_variant
-%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "@id": {{ product_url | append: '#product' | json }},
  "name": {{ product.title | strip_newlines | strip | json }},
  "description": {{ plain_description | json }},
  "url": {{ product_url | json }},
  "image": [
    {%- for image in product.images limit: 6 -%}
      {{ image | image_url: width: 1200 | prepend: 'https:' | json }}{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ],
  "brand": { "@type": "Brand", "name": {{ brand_name | json }} },
  {%- if product.type != blank %}
  "category": {{ product.type | json }},
  {%- endif %}
  {%- if first_variant.sku != blank %}
  "sku": {{ first_variant.sku | json }},
  {%- endif %}
  {%- if first_variant.barcode != blank %}
  "gtin": {{ first_variant.barcode | json }},
  {%- endif %}
  {%- if rating_value and rating_count > 0 %}
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": {{ rating_value.rating | json }},
    "bestRating": {{ rating_value.scale_max | json }},
    "worstRating": {{ rating_value.scale_min | json }},
    "ratingCount": {{ rating_count | json }}
  },
  {%- endif %}
  "offers": [
    {%- for variant in product.variants -%}
    {
      "@type": "Offer",
      "@id": {{ product_url | append: '?variant=' | append: variant.id | append: '#offer' | json }},
      "url": {{ product_url | append: '?variant=' | append: variant.id | json }},
      "name": {{ variant.title | strip_newlines | strip | json }},
      "price": {{ variant.price | divided_by: 100.0 | json }},
      "priceCurrency": {{ currency_code | json }},
      "priceValidUntil": {{ price_valid_until | json }},
      "itemCondition": "https://schema.org/NewCondition",
      "availability": {% if variant.available %}"https://schema.org/InStock"{% else %}"https://schema.org/OutOfStock"{% endif %},
      {%- if variant.sku != blank %}
      "sku": {{ variant.sku | json }},
      {%- endif %}
      {%- if variant.barcode != blank %}
      "gtin": {{ variant.barcode | json }},
      {%- endif %}
      "seller": { "@type": "Organization", "@id": {{ shop.url | append: '/#organization' | json }}, "name": "Prime Supplements" },
      "hasMerchantReturnPolicy": {
        "@type": "MerchantReturnPolicy",
        "applicableCountry": "RO",
        "returnPolicyCountry": "RO",
        "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
        "merchantReturnDays": 14,
        "returnMethod": "https://schema.org/ReturnByMail",
        "returnFees": "https://schema.org/ReturnShippingFees",
        "merchantReturnLink": {{ shop.url | append: '/pages/politica-de-retur' | json }}
      },
      "shippingDetails": {
        "@type": "OfferShippingDetails",
        "shippingRate": {
          "@type": "MonetaryAmount",
          "value": {% if variant.price >= 30000 %}0{% else %}20{% endif %},
          "currency": {{ currency_code | json }}
        },
        "shippingDestination": { "@type": "DefinedRegion", "addressCountry": "RO" },
        "deliveryTime": {
          "@type": "ShippingDeliveryTime",
          "handlingTime": { "@type": "QuantitativeValue", "minValue": 0, "maxValue": 1, "unitCode": "DAY" },
          "transitTime": { "@type": "QuantitativeValue", "minValue": 1, "maxValue": 3, "unitCode": "DAY" }
        }
      }
    }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}
