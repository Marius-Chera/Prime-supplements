  padding-top: 16px;\n    border-top: 1px solid #e9e9e9;\n    color: #666666;\n    font-size: 10px;\n    font-weight: 700;\n    line-height: 1.5;\n    letter-spacing: 0.08em;\n    text-transform: uppercase;\n  }\n\n  .prime-product-story .pps-image-caption span:last-child {\n    color: var(--prime-red);\n    text-align: right;\n  }\n\n  .prime-product-story .pps-stats {\n    display: grid;\n    grid-template-columns: repeat(4, minmax(0, 1fr));\n    margin: 36px 0 0;\n    padding: 0;\n    border-radius: 6px;\n    background: var(--prime-black);\n    overflow: hidden;\n  }\n\n  .prime-product-story .pps-stat {\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    gap: 10px;\n    min-width: 0;\n    padding: 28px 16px;\n    text-align: center;\n  }\n\n  .prime-product-story .pps-stat + .pps-stat {\n    border-left: 1px solid #383838;\n  }\n\n  .prime-product-story .pps-stat dt {\n    order: 2;\n    margin: 0;\n    color: #bcbcbc;\n    font-size: 10px;\n    font-weight: 650;\n    line-height: 1.5;\n    letter-spacing: 0.12em;\n    text-transform: uppercase;\n  }\n\n  .prime-product-story .pps-stat dd {\n    margin: 0;\n    color: #ffffff;\n    font-size: clamp(28px, 3vw, 42px);\n    font-weight: 800;\n    line-height: 1;\n    letter-spacing: -0.04em;\n  }\n\n  .prime-product-story .pps-stat dd small {\n    font-size: 0.5em;\n    font-weight: 600;\n  }\n\n  @media (max-width: 900px) {\n    .prime-product-story .pps-grid {\n      grid-template-columns: minmax(0, 1fr);\n      gap: 28px;\n    }\n\n    .prime-product-story .pps-title {\n      font-size: clamp(46px, 10vw, 80px);\n    }\n\n    .prime-product-story .pps-description {\n      max-width: none;\n    }\n\n    .prime-product-story .pps-media {\n      width: 100%;\n      max-width: 580px;\n      justify-self: center;\n    }\n  }\n\n  @media (max-width: 480px) {\n    .prime-product-story .pps-inner {\n      padding: 30px 20px;\n    }\n\n    .prime-product-story .pps-label {\n      font-size: 9px;\n      letter-spacing: 0.08em;\n    }\n\n    .prime-product-story .pps-description {\n      font-size: 14px;\n    }\n\n    .prime-product-story .pps-formula {\n      gap: 14px;\n      padding: 16px;\n    }\n\n    .prime-product-story .pps-formula strong {\n      font-size: 28px;\n    }\n\n    .prime-product-story .pps-media {\n      padding: 16px;\n    }\n\n    .prime-product-story .pps-stats {\n      grid-template-columns: repeat(2, minmax(0, 1fr));\n      margin-top: 24px;\n    }\n\n    .prime-product-story .pps-stat {\n      padding: 24px 12px;\n    }\n\n    .prime-product-story .pps-stat:nth-child(3) {\n      border-left: 0;\n    }\n\n    .prime-product-story .pps-stat:nth-child(n + 3) {\n      border-top: 1px solid #383838;\n    }\n  }\n</style>\n\n<section\n  class=\"prime-product-story\"\n  aria-label=\"Creatină monohidrată PRIME Supplements\"\n>\n  <div class=\"pps-inner\">\n    <div class=\"pps-grid\">\n\n      <div class=\"pps-copy\">\n        <p class=\"pps-label\">\n          PRIME Supplements® · Hardcore Sports Nutrition\n        </p>\n\n        <h2 class=\"pps-title\">\n          CREATINĂ\n          <span>MONOHIDRATĂ MICRONIZATĂ</span>\n        </h2>\n\n        <p class=\"pps-lead\">\n          Un singur ingredient.<br>\n          Pentru rutina ta de antrenament.\n        </p>\n\n        <p class=\"pps-description\">\n          Creatină monohidrată sub formă de pulbere fină,\n          micronizată. Fiecare porție de 5 g furnizează\n          5000 mg de creatină monohidrată, fără arome,\n          aditivi sau ingrediente de umplutură.\n        </p>\n\n        <ul class=\"pps-features\" aria-label=\"Caracteristici\">\n          <li>Micronizată</li>\n          <li>Fără aromă</li>\n          <li>Fără aditivi</li>\n        </ul>\n\n        <div class=\"pps-formula\">\n          <strong>100%</strong>\n          <p>\n            <b>Creatină monohidrată.</b>\n            O formulă simplă, de la PRIME Supplements.\n          </p>\n        </div>\n      </div>\n\n      <figure class=\"pps-media\">\n        <img\n          class=\"pps-image\"\n          src=\"https://primesupplements.ro/cdn/shop/files/ALLMERCH-CREATINE300g1.jpg?v=1772583366&amp;width=1400\"\n          alt=\"Creatină monohidrată micronizată PRIME Supplements, 300 g\"\n          loading=\"lazy\"\n          decoding=\"async\"\n        >\n\n        <figcaption class=\"pps-image-caption\">\n          <span>PRIME Supplements®</span>\n          <span>300 g / 60 de porții</span>\n        </figcaption>\n      </figure>\n\n    </div>\n\n    <dl class=\"pps-stats\">\n      <div class=\"pps-stat\">\n        <dt>Cantitate netă</dt>\n        <dd>300 <small>g</small></dd>\n      </div>\n\n      <div class=\"pps-stat\">\n        <dt>Porții per flacon</dt>\n        <dd>60</dd>\n      </div>\n\n      <div class=\"pps-stat\">\n        <dt>Cantitate per porție</dt>\n        <dd>5 <small>g</small></dd>\n      </div>\n\n      <div class=\"pps-stat\">\n        <dt>Creatină monohidrată / porție</dt>\n        <dd>5000 <small>mg</small></dd>\n      </div>\n    </dl>\n  </div>\n</section>"
